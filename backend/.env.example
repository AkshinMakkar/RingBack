ANTHROPIC_API_KEY=
# Claude model. browser-use docs currently use claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# Public URL Twilio hits (ngrok or Cloudflare Tunnel)
# Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# Facebook (or other) login for the agent
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Optional: attach to Chrome that's already open
# Start Chrome with: --remote-debugging-port=9222
# Then: CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_CDP_URL=

# Twilio Voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional, not wired yet
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

